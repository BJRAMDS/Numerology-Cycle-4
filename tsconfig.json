{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "module": "ESNext",

    /* Module Resolution */
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
   /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
